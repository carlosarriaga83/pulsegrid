# ==============================================================================
# PulseGrid - Variables de Entorno (.env.example)
# Copia este archivo a .env y completa los valores reales.
# Nunca subas el archivo .env al repositorio.
# ==============================================================================

# --- Servidor (Hostinger Node.js Web Apps) ---
NODE_ENV=production
PORT=3000
APP_URL=https://app.pulsegrid.com
CORS_ORIGIN=https://app.pulsegrid.com
LOG_LEVEL=info

# --- Base de Datos MySQL / MariaDB (Hostinger) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_pulsegrid
DB_USER=u123456789_admin
DB_PASSWORD=tu_password_seguro
DB_CONNECTION_LIMIT=10
DB_TIMEZONE=-05:00

# --- Tuya Cloud OpenAPI ---
# Regiones disponibles:
#   Western America: https://openapi.tuyaus.com
#   Eastern America: https://openapi-ueaz.tuyaus.com
#   Central Europe:  https://openapi.tuyaeu.com
#   Western Europe:  https://openapi-weaz.tuyaeu.com
#   China:           https://openapi.tuyacn.com
#   India:           https://openapi.tuyain.com
TUYA_BASE_URL=https://openapi.tuyaus.com
TUYA_ACCESS_KEY=tu_tuya_access_id
TUYA_SECRET_KEY=tu_tuya_access_secret
# UID del usuario de la app Smart Life / Tuya Smart vinculado al proyecto Cloud
TUYA_USER_UID=tu_tuya_app_user_uid

# --- Polling, Caché y Retención ---
# Intervalo de sincronización de dispositivos Tuya (en segundos)
POLLING_INTERVAL_SECONDS=30
# Intervalo de evaluación del motor de automatizaciones (expresión cron)
AUTOMATION_CRON_SCHEDULE=*/1 * * * *
# Días de retención para telemetría y logs antes de limpieza automática
TELEMETRY_RETENTION_DAYS=90
AUTOMATION_LOG_RETENTION_DAYS=30

# --- Open-Meteo (Clima y Amanecer/Atardecer - Sin API Key) ---
# Coordenadas por defecto para reglas ambientales y solares
WEATHER_LATITUDE=19.4326
WEATHER_LONGITUDE=-99.1332
WEATHER_TIMEZONE=America/Mexico_City
WEATHER_CACHE_MINUTES=15

# --- Alertas por Correo (SMTP / Nodemailer) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=alertas@pulsegrid.com
SMTP_PASS=tu_password_smtp
SMTP_FROM_NAME=PulseGrid Alertas
SMTP_FROM_EMAIL=alertas@pulsegrid.com
